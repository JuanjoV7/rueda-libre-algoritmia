Algoritmo cotizacion_basica
	
	Definir Nombre Como Caracter
	Definir PrecioHora Como Entero
	Definir Horas Como Entero
	Definir Costo Como Real
	
	PrecioHora = 10000
	
	Escribir "Ingrese su nombre"
	Leer Nombre
	
	Escribir "Ingrese el número de horas a alquilar"
	Leer Horas
	
	Costo = (PrecioHora * Horas)
	
	Escribir "Hola, ", nombre, " tu alquiler de ", horas," horas" ," cuesta $",Costo
	
	
	
FinAlgoritmo
