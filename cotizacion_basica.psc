Algoritmo cotizacion_basica
	
	Definir Nombre Como Caracter
	Definir PrecioHora Como Real
	Definir Horas Como Entero
	DEfinir ValorTotal Como Real
	
	PrecioHora = 10000
	
	Escribir "Ingrese su nombre"
	Leer Nombre
	
	Escribir "Ingrese numero de horas a alquilar"
	Leer Horas
	
	ValorTotal = (PrecioHora * Horas)
	Escribir "Hola: ", nombre, " tu alquiler por: ", Horas, " tiene un valor de: ", ValorTotal
FinAlgoritmo
